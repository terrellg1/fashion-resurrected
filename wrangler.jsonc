{
  "name": "fashion-resurrected",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}